   "title": "Note",
   "inputs": [],
   "outputs": [],
   "widgets_values": [
    "## Edit pixel art\nLoad a sprite at its **native** size (e.g. 64×64 PNG). It is upscaled onto a 1024 canvas, edited by FLUX.2 klein, then snapped back to the exact same grid.\nTwo outputs: free colours, and locked to the sprite's original palette.\nThe *Extra reference* (image 2) is optional — bypass it with Ctrl+B."
   ],
   "color": "#432",
   "bgcolor": "#653"
  },
